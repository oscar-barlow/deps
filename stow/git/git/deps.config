[user]
	name = Oscar Barlow
	email = oscar-barlow@users.noreply.github.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMKbWQrDTPTuRkPrNzt2jkJH/LkqjKzrp2QKfhribame
[core]
	editor = vim
[init]
	defaultBranch = master
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
